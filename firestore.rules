rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de verificação
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'ssj53415170@gmail.com';
    }

    // Regras para usuários
    match /users/{identifier} {
      allow read, write: if isSignedIn();
    }

    // Mensagens globais (leitura pública)
    match /global_messages/{messageId} {
      allow read: if true;
      allow write: if false;
    }

    // Backups
    match /backups/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Coleção de admins
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Candidaturas / Indicações
    match /candidaturas/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Sugestões de Empresa
    match /suggestions/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- NOVA REGRA DO RANKING ---
    match /salary_stats/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Promoções
    match /promocoes/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curtidas']);

      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['autor', 'texto', 'timestamp', 'promoId', 'uid', 'userId'])
          && request.resource.data.autor is string
          && request.resource.data.autor.size() > 0
          && request.resource.data.autor.size() <= 80
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500
          && request.resource.data.timestamp is int
          && request.resource.data.promoId == docId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Sorteios
    match /raffles/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /raffle_entries/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.raffleId == resource.data.raffleId;

      allow read: if isAdmin()
        || isSignedIn();

      allow delete: if isAdmin();
    }
  }
}
